<UserControl x:Class="CloudSource.Playnite.CloudSourceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Managed storage" />
            <TextBlock Margin="0,8,0,8" TextWrapping="Wrap"
                        Text="Cloud Storage keeps installed games, staging files, and its cache below one managed root." />
            <Button HorizontalAlignment="Left" Margin="0,0,0,12" Padding="10,4"
                    Content="View privacy policy" Command="{Binding OpenPrivacyPolicyCommand}" />
            <TextBlock Text="Managed root" />
            <TextBox Margin="0,4,0,0"
                     Text="{Binding Settings.ManagedRootPath, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="The root must be an absolute folder and cannot be a filesystem root such as C:\." />

            <Separator Margin="0,20,0,16" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Google Drive" />
            <TextBlock Margin="0,8,0,12" TextWrapping="Wrap"
                        Text="The first provider is read-only. Cloud Storage discovers ZIP, 7z, and RAR archives and never deletes them during local uninstall." />

            <TextBlock Margin="0,0,0,12" Opacity="0.7" TextWrapping="Wrap"
                       Text="Before connecting: Cloud Storage will read Drive file and folder metadata and download files you choose to install, solely to show and install your games in Playnite. It never modifies cloud files or shares Google user data with the author, advertisers, or other third parties. OAuth tokens are encrypted for this Windows account. Clicking Connect opens Google's consent screen." />

            <StackPanel Orientation="Horizontal">
                <Button MinWidth="150" Padding="12,5" Content="Connect Google Drive"
                        Command="{Binding ConnectGoogleDriveCommand}" />
                <Button MinWidth="110" Margin="8,0,0,0" Padding="12,5" Content="Disconnect"
                        Command="{Binding DisconnectGoogleDriveCommand}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,12" Text="{Binding GoogleDriveStatus}" TextWrapping="Wrap" />

            <TextBlock Text="Game archive folder" />
            <Border Margin="0,4,0,8" Padding="10" BorderThickness="1" BorderBrush="#40708090">
                <DockPanel>
                    <Button DockPanel.Dock="Right" MinWidth="120" Margin="12,0,0,0" Padding="10,5"
                            Content="Choose folder..." Command="{Binding ChooseGoogleDriveFolderCommand}" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding GoogleDriveFolderSelectionStatus}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <TextBlock Margin="0,0,0,8" Opacity="0.7" TextWrapping="Wrap"
                       Text="Choose a concrete folder from My Drive or Shared with me. Cloud Storage stores its stable Drive ID, so renaming the folder does not redirect the source." />

            <Separator Margin="0,20,0,16" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="OneDrive" />
            <TextBlock Margin="0,8,0,12" TextWrapping="Wrap"
                       Text="OneDrive is read-only. It uses the same archive, installer-bundle, and ROM discovery rules as Google Drive." />

            <TextBlock Margin="0,0,0,12" Opacity="0.7" TextWrapping="Wrap"
                       Text="Before connecting: Cloud Storage will read OneDrive file and folder metadata and download files you choose to install, solely to show and install your games in Playnite. It never modifies cloud files or shares Microsoft user data with the author, advertisers, or other third parties. OAuth tokens are encrypted for this Windows account. Clicking Connect opens Microsoft's consent screen." />

            <StackPanel Orientation="Horizontal">
                <Button MinWidth="150" Padding="12,5" Content="Connect OneDrive"
                        Command="{Binding ConnectOneDriveCommand}" />
                <Button MinWidth="110" Margin="8,0,0,0" Padding="12,5" Content="Disconnect"
                        Command="{Binding DisconnectOneDriveCommand}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,12" Text="{Binding OneDriveStatus}" TextWrapping="Wrap" />

            <TextBlock Text="Game archive folder" />
            <Border Margin="0,4,0,8" Padding="10" BorderThickness="1" BorderBrush="#40708090">
                <DockPanel>
                    <Button DockPanel.Dock="Right" MinWidth="120" Margin="12,0,0,0" Padding="10,5"
                            Content="Choose folder..." Command="{Binding ChooseOneDriveFolderCommand}" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding OneDriveFolderSelectionStatus}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <TextBlock Margin="0,0,0,8" Opacity="0.7" TextWrapping="Wrap"
                       Text="Choose a concrete folder from OneDrive My files. The stable drive item ID is retained if the folder is renamed." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
